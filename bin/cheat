def get_term_width():
    w = shutil.get_terminal_size((80, 24)).columns
    return min(max(w, 75), 110)

def format_header(title, subtitle=None):
    width = get_term_width()
    line = "─" * (width - 2)
    res = [
        f"{CYAN}{BOLD}┌{line}┐{RESET}",
        f"{CYAN}{BOLD}│{RESET} {BOLD}{title}{RESET}".ljust(width + 12) + f"{CYAN}{BOLD}│{RESET}"
    ]
    if subtitle:
        res.append(f"{CYAN}{BOLD}│{RESET} {DIM}{subtitle}{RESET}".ljust(width + 12) + f"{CYAN}{BOLD}│{RESET}")
    res.append(f"{CYAN}{BOLD}└{line}┘{RESET}")
    return "\n".join(res)

def render_category(cat):
    output = []
    output.append(f"{YELLOW}{BOLD}{cat['title']}{RESET}")
    output.append(f"{DIM}   {cat['desc']}{RESET}")
    cmd_col_width = 22
    desc_col_width = 33
    for cmd, desc, note in cat["items"]:
        cmd_styled = f"{GREEN}{BOLD}{cmd.ljust(cmd_col_width)}{RESET}"
        desc_styled = f"{WHITE}{desc.ljust(desc_col_width)}{RESET}"
        note_styled = f"{DIM}# {note}{RESET}"
        output.append(f"  {cmd_styled} {desc_styled} {note_styled}")
    output.append("")
    return "\n".join(output)

def render_dashboard():
    lines = []
    lines.append(format_header("🛠️  全能开发者工作流速查手册 (Cheatsheet Dashboard)", 
                               "输入 'cheat <分类名>' 精准查看，或 'cheat -i' 交互检索"))
    lines.append("")
    lines.append(f"{BOLD}{WHITE}📂 可用速查分类 (输入命令直达对应版块)：{RESET}")
    lines.append("")
    for cat in DATA:
        badge = f"{CYAN}{BOLD}[cheat {cat['id']}]{RESET}".ljust(22)
        title = f"{YELLOW}{BOLD}{cat['title'].split()[0]} {cat['title'].split()[1]}{RESET}".ljust(35)
        count = f"{DIM}({len(cat['items'])} 条指令){RESET}"
        desc = f"{WHITE}{cat['desc']}{RESET}"
        lines.append(f"  {badge} {title} {count}")
        lines.append(f"     {DIM}└─ {desc}{RESET}")
        lines.append("")

    lines.append(f"{MAGENTA}{BOLD}⚡ 精选高频核心连招 (Quick Highlights)：{RESET}")
    highlights = [
        ("bhal", "Lyric HAL 代码改完一键「编译+推机+重启相机」", "日常真机调试最强命令"),
        ("camlog", "实时抓取真机相机核心服务 Logcat 日志", "另一终端窗口常驻查看"),
        ("y (yazi)", "终端文件管理器；按 'l' 进目录/开nvim，按 'T h' 折叠预览", "退出自动 cd 当前目录"),
        ("nvim: <leader><space>", "智能文件搜索；<leader>/ 全局搜索；Space 等候呼出 WhichKey", "Snacks + WhichKey"),
        ("tmux: Ctrl+Space", "专属 Prefix 键；Alt+i/j/k/l 切分屏；Alt+w 开新窗口", "已深度绑定 ~/.config/tmux"),
        ("rsync-hal", "秒级同步 LyricCameraHAL 单一模块，免去整树同步等待", "Mentor 工作流推荐"),
        ("cheat -i", "启动 FZF 交互式按键搜索器，支持实时打字过滤命令", "交互式全量搜索"),
    ]
    for cmd, desc, note in highlights:
        cmd_styled = f"{GREEN}{BOLD}{cmd.ljust(24)}{RESET}"
        desc_styled = f"{WHITE}{desc.ljust(44)}{RESET}"
        note_styled = f"{DIM}# {note}{RESET}"
        lines.append(f"  {cmd_styled} {desc_styled} {note_styled}")
    lines.append("")
    lines.append(f"{BLUE}{BOLD}💡 操作提示：{RESET}上下翻动: {GREEN}j/k{RESET} 或 {GREEN}↑/↓{RESET} | 退出: {GREEN}q{RESET} | 搜索: {GREEN}/{RESET} | Neovim打开: {GREEN}cheat -v{RESET}")
    return "\n".join(lines)

def display_page(text, raw=False):
    # If explicitly requested raw output, or stdout is piped, or running in agent test runner
    if raw or not sys.stdout.isatty() or os.environ.get("PAGER") == "cat":
        print(text)
        return

    # Check if less is available
    if shutil.which("less"):
        prompt = " 📖 速查手册 (Cheatsheet) [j/k 或 ↑/↓ 上下翻动 | / 搜索 | q 退出]"
        cmd = ["less", "-R", "-i", "-s", "-P", prompt]
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, text=True)
            p.communicate(input=text)
            return
        except Exception:
            pass

    print(text)

def run_fzf_interactive():
    if not shutil.which("fzf"):
        print(f"{YELLOW}未找到 fzf，回退到普通文本展示。{RESET}")
        render_dashboard()
        return

    lines = []
    for cat in DATA:
        for cmd, desc, note in cat["items"]:
            # Format: Category | Command | Description | Note
            lines.append(f"[{cat['badge']}]	{cmd}	{desc}	{note}")

    fzf_input = "\n".join(lines)
    try:
        preview_cmd = 'echo "分类: {1}\n命令: \033[1;32m{2}\033[0m\n说明: \033[1m{3}\033[0m\n详细: {4}"'
        res = subprocess.run(
            ["fzf", "--ansi", "--delimiter=	", 
             "--with-nth=1,2,3", 
             "--preview", preview_cmd,
             "--preview-window=down:4:wrap",
             "--header=回车选择命令 (ESC 退出)",
             "--prompt=🔍 Cheat > "],
            input=fzf_input,
            text=True,
            capture_output=True
        )
        if res.returncode == 0 and res.stdout.strip():
            selected = res.stdout.strip().split("	")
            cmd = selected[1]
            desc = selected[2]
            note = selected[3]
            print(f"{GREEN}{BOLD}已选定命令: {cmd}{RESET}")
            print(f"{WHITE}说明: {desc}{RESET} ({DIM}{note}{RESET})")
            print(f"{CYAN}可以直接复制或在终端中运行。{RESET}")
    except Exception as e:
        print(f"{YELLOW}交互模式异常: {e}{RESET}")

def main():
    args = sys.argv[1:]

    # Check raw output flag
    raw = False
    if "--raw" in args:
        raw = True
        args.remove("--raw")
    elif "-r" in args:
        raw = True
        args.remove("-r")

    # Edit option in Neovim (writable)
    if args and args[0] in ("-e", "--edit", "edit"):
        editor = os.environ.get("EDITOR", "nvim")
        os.execvp(editor, [editor, CHEATSHEET_PATH])

    # Neovim Read-only View mode (with q mapped to :q<CR>)
    if args and args[0] in ("-v", "--view", "view"):
        target_category = args[1].lower() if len(args) > 1 else None
        jump_arg = []
        if target_category:
            heading_map = {
                "hal": "1. .*Lyric Camera HAL",
                "android": "1. .*Lyric Camera HAL",
                "lyric": "1. .*Lyric Camera HAL",
                "yazi": "2. .*Yazi",
                "ya": "2. .*Yazi",
                "nvim": "3. .*Neovim",
                "vim": "3. .*Neovim",
                "tmux": "4. .*Tmux",
                "lg": "5. .*Lazygit",
                "lazygit": "5. .*Lazygit",
                "git": "6. .*代码同步与版本管理",
                "repo": "6. .*代码同步与版本管理",
                "shell": "7. .*终端生产力与智能检索",
                "tools": "8. .*市面优秀命令提示",
            }
            pat = heading_map.get(target_category)
            if pat:
                jump_arg = ["-c", f"silent! /{pat}", "-c", "nohlsearch"]

        nvim_cmd = ["nvim", "-R", "-M", "-c", "nnoremap q :q<CR>"] + jump_arg + [CHEATSHEET_PATH]
        os.execvp("nvim", nvim_cmd)

    # FZF Interactive mode
    if args and args[0] in ("-i", "--interactive", "fzf"):
        run_fzf_interactive()
        return

    # No argument: Show Dashboard
    if not args:
        display_page(render_dashboard(), raw=raw)
        return

    query = args[0].lower()

    # Special case: all
    if query == "all":
        parts = [format_header("🛠️  全量开发者工作流速查手册 (All Categories)"), ""]
        for cat in DATA:
            parts.append(render_category(cat))
        display_page("\n".join(parts), raw=raw)
        return

    # Check for direct category match
    matched_cat = None
    for cat in DATA:
        if query == cat["id"] or query in cat["aliases"]:
            matched_cat = cat
            break

    if matched_cat:
        header = format_header(f"{matched_cat['title']}", f"分类直达速查 ─ 输入 'cheat' 返回仪表盘")
        body = render_category(matched_cat)
        display_page(f"{header}\n\n{body}", raw=raw)
        return

    # Otherwise: keyword search across all categories
    full_query = " ".join(args).lower()
    matches = []
    for cat in DATA:
        cat_matches = []
        for cmd, desc, note in cat["items"]:
            if full_query in (cmd + desc + note).lower():
                cat_matches.append((cmd, desc, note))
        if cat_matches:
            matches.append((cat, cat_matches))

    if matches:
        parts = [format_header(f"🔍 搜索结果: '{full_query}'", f"共找到 {sum(len(m[1]) for m in matches)} 条匹配"), ""]
        for cat, items in matches:
            parts.append(f"{YELLOW}{BOLD}{cat['title']}{RESET}")
            cmd_col_width = 22
            desc_col_width = 33
            for cmd, desc, note in items:
                cmd_styled = f"{GREEN}{BOLD}{cmd.ljust(cmd_col_width)}{RESET}"
                desc_styled = f"{WHITE}{desc.ljust(desc_col_width)}{RESET}"
                note_styled = f"{DIM}# {note}{RESET}"
                parts.append(f"  {cmd_styled} {desc_styled} {note_styled}")
            parts.append("")
        display_page("\n".join(parts), raw=raw)
    else:
        err = [
            f"{YELLOW}⚠️ 未找到与 '{full_query}' 匹配的快捷命令。{RESET}",
            f"输入 {GREEN}cheat{RESET} 查看分类索引，或输入 {GREEN}cheat -i{RESET} 启动模糊检索。"
        ]
        display_page("\n".join(err), raw=raw)

if __name__ == "__main__":
    main()
