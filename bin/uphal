#!/usr/bin/env bash
# ==============================================================================
# uphal - Update Lyric Camera HAL APEX on device
# ==============================================================================
set -euo pipefail

# Auto-detect if current directory is inside ~/workspaces/<name>
if [[ "$PWD" == "$HOME/workspaces/"* ]]; then
  _ws_rel="${PWD#"$HOME/workspaces/"}"
  _ws_name="${_ws_rel%%/*}"
  if [[ -d "$HOME/workspaces/$_ws_name" ]]; then
    ANDROID_TOP="$HOME/workspaces/$_ws_name"
  fi
fi
ANDROID_TOP="${ANDROID_TOP:-${ANDROID_BUILD_TOP:-$HOME/android_workspace}}"
if [[ -n "${OUT:-}" && "$OUT" == "$ANDROID_TOP/"* ]]; then
  OUT_DIR="$OUT"
else
  OUT_DIR="$ANDROID_TOP/out/target/product/sasquatch"
fi
TARGET_APEX="${OUT_DIR}/vendor/apex/com.google.pixel.camera.hal.apex"

USE_DEBUG=0
SERIAL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug|-d)
      USE_DEBUG=1
      shift
      ;;
    -s)
      SERIAL="$2"
      shift 2
      ;;
    *)
      if [[ -z "$SERIAL" ]]; then
        SERIAL="$1"
      fi
      shift
      ;;
  esac
done

if [[ "$USE_DEBUG" -eq 1 ]]; then
  TARGET_APEX="${OUT_DIR}/vendor/apex/com.google.pixel.camera.hal.debug.apex"
fi

if [[ ! -f "$TARGET_APEX" ]]; then
  echo "❌ APEX file not found:"
  echo "   $TARGET_APEX"
  echo "💡 Tip: Run 'mlyric' first to build the APEX."
  exit 1
fi

ADB_CMD=(adb)
if [[ -n "$SERIAL" ]]; then
  ADB_CMD+=( -s "$SERIAL" )
fi

if [[ "${LQUEUE_DEVICE_LOCK_HELD:-0}" != "1" ]] && [[ -x "$HOME/.local/bin/lqueue" ]]; then
  exec "$HOME/.local/bin/lqueue" device -s "$SERIAL" -l "uphal $(basename "$TARGET_APEX")" -- "$0" "$@"
fi

echo "=========================================="
echo "📱 Target APEX: $(basename "$TARGET_APEX")"
echo "📂 Location   : $TARGET_APEX"
if [[ -n "$SERIAL" ]]; then
  echo "🎯 Device     : $SERIAL"
fi
echo "=========================================="

echo "🚀 Installing APEX to device..."
"${ADB_CMD[@]}" shell "su 0 sh -c '
  am force-stop com.google.android.GoogleCamera 2>/dev/null || true
  am force-stop com.google.android.GoogleCameraEng 2>/dev/null || true
  sleep 1
  nsenter -t 1 -m -- umount -l /apex/com.google.pixel.camera.hal/lib64/liblyric_hwl.so 2>/dev/null || true
  nsenter -t 1 -m -- umount -l /apex/com.google.pixel.camera.hal/lib64 2>/dev/null || true
  umount -l /apex/com.google.pixel.camera.hal/lib64/liblyric_hwl.so 2>/dev/null || true
  umount -l /apex/com.google.pixel.camera.hal/lib64 2>/dev/null || true
'" || true
"${ADB_CMD[@]}" install --apex --force-non-staged "$TARGET_APEX"

echo "🔄 Restarting camera service..."
"${ADB_CMD[@]}" shell "su 0 sh -c '
  nsenter -t 1 -m -- umount -l /apex/com.google.pixel.camera.hal/lib64/liblyric_hwl.so 2>/dev/null || true
  nsenter -t 1 -m -- umount -l /apex/com.google.pixel.camera.hal/lib64 2>/dev/null || true
  setprop ctl.restart vendor.camera-provider-2-7-google 2>/dev/null || killall -9 android.hardware.camera.provider@2.7-service-google 2>/dev/null || true
'" || true

echo "✅ Lyric HAL updated successfully!"
